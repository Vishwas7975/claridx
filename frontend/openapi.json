  "paths": {
    "/api/v1/diabetes/features": {
      "get": {
        "description": "Input features with labels, units and allowed values, in form display order.",
        "operationId": "list_features_api_v1_diabetes_features_get",
        "responses": {
          "200": {
            "content": {
