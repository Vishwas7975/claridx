            "description": "Diabetes pedigree function",
            "title": "Pedi"
          },
          "plas": {
            "anyOf": [
              {
                "maximum": 500.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Plasma glucose concentration (mg/dL; 0 = unmeasured)",
            "title": "Plas"
          },
          "preg": {
            "anyOf": [
              {
                "maximum": 25.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Number of pregnancies",
            "title": "Preg"
          },
          "pres": {
            "anyOf": [
              {
                "maximum": 300.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Diastolic blood pressure (mm Hg; 0 = unmeasured)",
            "title": "Pres"
          },
          "skin": {
            "anyOf": [
              {
                "maximum": 120.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Triceps skin fold thickness (mm; 0 = unmeasured)",
            "title": "Skin"
          }
        },
