          "age": {
            "anyOf": [
              {
                "maximum": 120.0,
                "minimum": 21.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Age in years (cohort inclusion criterion: >= 21)",
            "title": "Age"
          },
          "insu": {
            "anyOf": [
              {
                "maximum": 1000.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "2-hour serum insulin (mu U/ml; 0 = unmeasured)",
            "title": "Insu"
          },
          "mass": {
            "anyOf": [
              {
                "maximum": 100.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
