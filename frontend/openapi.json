      "DiabetesPatientInput": {
        "additionalProperties": false,
        "description": "Measurements for one patient. At least 5 effective measurements required.\n\nValue codes and units are listed by GET /api/v1/diabetes/features.\nZeros in plas, pres, skin, insu, mass are unmeasured and do not count.",
